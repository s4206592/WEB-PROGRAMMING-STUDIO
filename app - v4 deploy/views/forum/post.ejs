<%- include('../partials/header', { pageTitle: post.title }) %>
<div class="container" style="padding:40px 0; max-width:680px;">
  <h1><%= post.title %></h1>
  <p class="muted">by <%= post.authorSnapshot.username %></p>
  <p><%= post.body %></p>

  <% if (canManage) { %>
    <div class="row" style="margin-bottom:20px;">
      <a href="/forum/<%= post._id %>/edit" class="btn btn-secondary">Edit</a>
      <form method="POST" action="/forum/<%= post._id %>/delete" onsubmit="return confirm('Delete this post?');">
        <button class="btn btn-danger" type="submit">Delete</button>
      </form>
    </div>
  <% } %>

  <h3 style="margin-top:36px;">Replies</h3>
  <% if (replies.length === 0) { %><p class="muted">No replies yet.</p><% } %>
  <div class="stack">
    <% replies.forEach(function(r) { %>
      <div class="card"><div class="card-body">
        <p><%= r.body %></p>
        <p class="muted" style="font-size:12px;">— <%= r.authorSnapshot.username %></p>
      </div></div>
    <% }) %>
  </div>

  <% if (currentUser) { %>
    <form id="reply-form" method="POST" action="/forum/<%= post._id %>/reply" style="margin-top:20px;">
      <div class="field"><textarea name="body" rows="3" placeholder="Write a reply…"></textarea><div class="field-error">Reply can't be empty.</div></div>
      <button class="btn btn-primary" type="submit">Reply</button>
    </form>
  <% } %>
</div>
<script src="/js/forum.js"></script>
<%- include('../partials/footer') %>
