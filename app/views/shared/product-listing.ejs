<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="page-wrap">
  <div class="two-col">
    <aside class="box">
      <div class="box-title">Filters</div>
      <form method="get" action="/products">
        <% if (query.q) { %><input type="hidden" name="q" value="<%= query.q %>"><% } %>
        <div class="filter-group">
          <div class="wf-label">Category</div>
          <% roots.forEach(function(r){ %>
            <label><input type="checkbox" name="category" value="<%= r._id %>" <%= selectedCats.includes(String(r._id)) ? 'checked' : '' %>> <strong><%= r.name %></strong></label>
            <% (byParent[r._id] || []).forEach(function(c){ %>
              <label style="padding-left:14px;"><input type="checkbox" name="category" value="<%= c._id %>" <%= selectedCats.includes(String(c._id)) ? 'checked' : '' %>> <%= c.name %></label>
            <% }) %>
          <% }) %>
        </div>
        <div class="filter-group">
          <div class="wf-label">Condition</div>
          <label><input type="radio" name="condition" value="" <%= !query.condition ? 'checked' : '' %>> All</label>
          <label><input type="radio" name="condition" value="new" <%= query.condition === 'new' ? 'checked' : '' %>> New</label>
          <label><input type="radio" name="condition" value="secondhand" <%= query.condition === 'secondhand' ? 'checked' : '' %>> Secondhand</label>
        </div>
        <div class="filter-group">
          <div class="wf-label">Price range (₫)</div>
          <div class="form-row"><input type="text" name="minPrice" placeholder="Min" value="<%= query.minPrice || '' %>"></div>
          <div class="form-row"><input type="text" name="maxPrice" placeholder="Max" value="<%= query.maxPrice || '' %>"></div>
        </div>
        <div class="filter-group">
          <div class="wf-label">Province</div>
          <select name="province">
            <option value="">Anywhere</option>
            <% VN_PROVINCES.forEach(function(p){ %><option value="<%= p %>" <%= query.province === p ? 'selected' : '' %>><%= p %></option><% }) %>
          </select>
        </div>
        <div class="filter-group">
          <div class="wf-label">Listing type</div>
          <label><input type="radio" name="type" value="" <%= !query.type ? 'checked' : '' %>> All</label>
          <label><input type="radio" name="type" value="sale" <%= query.type === 'sale' ? 'checked' : '' %>> For sale</label>
          <label><input type="radio" name="type" value="wanted" <%= query.type === 'wanted' ? 'checked' : '' %>> Wanted</label>
          <label><input type="checkbox" name="negotiable" <%= query.negotiable === 'on' ? 'checked' : '' %>> Accepts offers</label>
        </div>
        <button class="btn small" type="submit">Apply filters</button>
        <a class="btn small secondary" href="/products">Clear</a>
      </form>
    </aside>

    <main>
      <div class="section-bar" style="margin-top:0;">
        <h2>
          <%= query.q ? 'Results for "' + query.q + '"' : 'All products' %>
          <span class="wf-label">(<%= total %> result<%= total === 1 ? '' : 's' %>)</span>
        </h2>
        <form method="get" action="/products" style="display:flex;gap:6px;align-items:center;">
          <% Object.keys(query).forEach(function(k){ if (k !== 'sort' && k !== 'page') { %>
            <% [].concat(query[k]).forEach(function(v){ %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %>
          <% } }) %>
          <select name="sort" onchange="this.form.submit()">
            <option value="newest" <%= sortKey === 'newest' ? 'selected' : '' %>>Newest</option>
            <option value="oldest" <%= sortKey === 'oldest' ? 'selected' : '' %>>Oldest</option>
            <option value="price_asc" <%= sortKey === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
            <option value="price_desc" <%= sortKey === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
            <option value="rating" <%= sortKey === 'rating' ? 'selected' : '' %>>Best rated</option>
          </select>
        </form>
      </div>

      <% if (!products.length) { %>
        <%- include('../partials/empty', {
          emptyTitle: total === 0 && !query.q ? 'No listings yet' : 'Nothing matched',
          emptyBody: total === 0 && !query.q
            ? 'No one has posted an item for sale. Sign up and list the first one.'
            : 'Try widening the price range, clearing a filter, or searching for something else.',
          emptyCta: currentUser ? { href: '/sell/new', label: 'List an item' } : { href: '/register', label: 'Create an account' }
        }) %>
      <% } else { %>
        <div class="card-grid">
          <% products.forEach(function(p){ %><%- include('../partials/productcard', { p: p }) %><% }) %>
        </div>
        <%- include('../partials/pagination') %>
      <% } %>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
