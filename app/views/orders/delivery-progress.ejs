<%- include('../partials/header', { pageTitle: 'Delivery progress' }) %>
<div class="container" style="padding:48px 0; max-width:640px;">
  <h1 class="section-title">Order #<%= order.orderNumber %></h1>

  <% if (order.status === 'cancelled') { %>
    <div class="alert alert-error">This order was declined by the seller and won't be fulfilled.</div>
  <% } else { %>
    <div class="stepper" id="delivery-stepper">
      <% ['confirmed','shipped','delivered'].forEach(function(stage, idx) {
         var reached = order.deliveryMilestones.some(function(m){ return m.stage === stage; }); %>
        <% if (idx > 0) { %>
          <div class="stepper-line"><div class="stepper-line-fill" data-fill="<%= reached ? '1' : '0' %>"></div></div>
        <% } %>
        <div class="stepper-step <%= reached ? 'reached' : '' %>">
          <div class="stepper-dot"><%= reached ? '✓' : (idx + 1) %></div>
          <div class="stepper-label"><%= stage %></div>
        </div>
      <% }) %>
    </div>
    <p class="muted mono" style="font-size:12px;">Payment: <%= order.payment.status === 'paid' ? 'Cash collected on delivery' : 'Pending — Cash on Delivery' %></p>
  <% } %>

  <% if (isSeller) { %>
    <div class="row" style="margin-top:20px;">
      <% if (order.status === 'placed') { %>
        <form method="POST" action="/orders/<%= order._id %>/confirm"><button class="btn btn-primary" type="submit">Confirm order</button></form>
        <form method="POST" action="/orders/<%= order._id %>/decline" onsubmit="return confirm('Decline this order? This cannot be undone.');"><button class="btn btn-danger" type="submit">Decline</button></form>
      <% } else if (order.status === 'confirmed') { %>
        <form method="POST" action="/orders/<%= order._id %>/ship"><button class="btn btn-primary" type="submit">Mark as shipped</button></form>
      <% } else if (order.status === 'shipped') { %>
        <form method="POST" action="/orders/<%= order._id %>/mark-delivered"><button class="btn btn-primary" type="submit">Mark as delivered</button></form>
      <% } %>
    </div>
  <% } %>

  <% if (order.status === 'delivered') { %>
    <div class="stack" style="margin-top:24px;">
      <p class="muted">Delivered. You can now review each product you bought.</p>
      <% order.items.forEach(function(i) { %>
        <div class="row-with-thumb" style="margin-bottom:8px;">
          <div class="row-thumb"><% if (i.productSnapshot.image) { %><img src="<%= i.productSnapshot.image %>" alt=""/><% } else { %>NO IMAGE<% } %></div>
          <a href="/products/<%= i.productId %>/review" class="btn btn-primary">Review "<%= i.productSnapshot.title %>"</a>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
<script>
  // Animate the stepper's connector lines filling in on load, instead of
  // rendering already-full — the CSS transition needs the width to change
  // *after* the initial paint, not be set to its final value up front.
  document.querySelectorAll('.stepper-line-fill[data-fill="1"]').forEach((el) => {
    requestAnimationFrame(() => requestAnimationFrame(() => { el.style.width = '100%'; }));
  });
</script>
<%- include('../partials/footer') %>
