<%- include('../partials/header', { pageTitle: 'Orders to fulfill' }) %>
<div class="container" style="padding:40px 0; max-width:760px;">
  <h1 class="section-title">Orders to fulfill</h1>
  <% if (orders.length === 0) { %>
    <div class="empty-state">No orders for your listings yet.</div>
  <% } else { %>
    <div class="stack">
      <% orders.forEach(function(order) { %>
        <div class="card"><div class="card-body">
          <div class="between">
            <strong class="mono">#<%= order.orderNumber %></strong>
            <span class="pill <%= order.status === 'delivered' ? 'pill-active' : order.status === 'cancelled' ? 'pill-flagged' : 'pill-pending' %>"><%= order.status %></span>
          </div>
          <p class="muted" style="font-size:13px;">Buyer: <%= order.buyerSnapshot.username %> · ₫<%= order.totals.total.toLocaleString() %> (Cash on Delivery)</p>
          <div class="stack" style="margin:10px 0; gap:8px;">
            <% order.items.forEach(function(i) { %>
              <div class="row-with-thumb">
                <div class="row-thumb"><% if (i.productSnapshot.image) { %><img src="<%= i.productSnapshot.image %>" alt=""/><% } else { %>NO IMAGE<% } %></div>
                <span style="font-size:13px;"><%= i.productSnapshot.title %> × <%= i.quantity %></span>
              </div>
            <% }) %>
          </div>
          <p class="muted" style="font-size:12px;">Ship to: <%= order.delivery.address %> · <%= order.delivery.contactPhone %> · <%= order.delivery.shippingMethod %></p>

          <div class="row" style="margin-top:12px;">
            <% if (order.status === 'placed') { %>
              <form method="POST" action="/orders/<%= order._id %>/confirm"><button class="btn btn-primary" type="submit">Confirm order</button></form>
              <form method="POST" action="/orders/<%= order._id %>/decline" onsubmit="return confirm('Decline this order? This cannot be undone.');"><button class="btn btn-danger" type="submit">Decline</button></form>
            <% } else if (order.status === 'confirmed') { %>
              <form method="POST" action="/orders/<%= order._id %>/ship"><button class="btn btn-primary" type="submit">Mark as shipped</button></form>
            <% } else if (order.status === 'shipped') { %>
              <form method="POST" action="/orders/<%= order._id %>/mark-delivered"><button class="btn btn-primary" type="submit">Mark as delivered</button></form>
            <% } %>
            <a href="/orders/<%= order._id %>/delivery" class="btn btn-secondary">Details</a>
          </div>
        </div></div>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
