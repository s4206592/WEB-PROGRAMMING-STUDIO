<%- include('../partials/header', { pageTitle: 'Checkout' }) %>
<div class="container" style="padding:40px 0; max-width:560px;">
  <h1 class="section-title">Checkout</h1>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <p class="muted">Delivery and order review are on this one page for the class-project checkout flow.</p>
  <% if (negotiatedConversationId) { %>
    <p class="muted" style="font-size:13px;">Checking out at the price agreed in your <a href="/messages/<%= negotiatedConversationId %>">chat with the seller</a>.</p>
  <% } %>
  <form id="checkout-form" method="POST" action="/checkout">
    <% if (negotiatedConversationId) { %><input type="hidden" name="negotiatedConversationId" value="<%= negotiatedConversationId %>" /><% } %>
    <h3 style="margin-top:24px;">Delivery</h3>
    <div class="field"><label>Address</label><input name="address" required /></div>
    <div class="field"><label>Contact phone</label><input name="contactPhone" required /></div>

    <h3>Shipping &amp; review</h3>
    <% var grandSubtotal = 0; %>
    <div class="stack" style="margin-bottom:20px; gap:16px;">
      <% sellerGroups.forEach(function(group) { %>
        <% var groupSubtotal = 0; %>
        <% group.items.forEach(function(i) { groupSubtotal += i.productSnapshot.price * i.quantity; }) %>
        <% grandSubtotal += groupSubtotal; %>
        <div class="card" style="padding:16px;">
          <p class="muted" style="font-size:12px; margin-top:0;">Sold by <strong><%= group.sellerName %></strong></p>
          <% group.items.forEach(function(i) { %>
            <div class="between"><span><%= i.productSnapshot.title %> × <%= i.quantity %></span><span class="mono">₫<%= (i.productSnapshot.price * i.quantity).toLocaleString() %></span></div>
          <% }) %>

          <div class="field" style="margin-top:10px; margin-bottom:0;">
            <label>Shipping method</label>
            <select name="shippingMethod_<%= group.sellerId %>">
              <option value="Standard">Standard delivery (3–5 days) — ₫30,000, Cash on Delivery</option>
              <option value="Express">Express delivery (1–2 days) — ₫30,000, Cash on Delivery</option>
              <% if (group.pickupEligible) { %>
                <option value="Pickup">Local pickup in <%= group.pickupCity || 'person' %> — free, Cash on Pickup</option>
              <% } %>
            </select>
          </div>
        </div>
      <% }) %>
      <% if (sellerGroups.length > 1) { %>
        <p class="muted" style="font-size:12px;">Items are from <%= sellerGroups.length %> different sellers, so this will be placed as <%= sellerGroups.length %> separate orders, each with its own shipping method.</p>
      <% } %>
      <div class="between" style="font-weight:700; border-top:1px solid var(--line); padding-top:8px;"><span>Items subtotal</span><span class="mono">₫<%= grandSubtotal.toLocaleString() %></span></div>
      <p class="muted" style="font-size:12px; margin-top:-8px;">Shipping is ₫30,000 per order for Standard/Express, ₫0 for local pickup — the exact total per order shows on your order confirmation once placed.</p>
    </div>
    <button class="btn btn-primary btn-block" type="submit">Place order</button>
  </form>
</div>
<script src="/js/checkout.js"></script>
<%- include('../partials/footer') %>
