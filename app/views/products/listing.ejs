<%- include('../partials/header', { pageTitle: 'Marketplace' }) %>
<div class="container" style="padding:40px 0;">
  <div class="between" style="align-items:flex-end; margin-bottom:24px;">
    <h1 class="section-title" style="margin-bottom:0;">All listings</h1>
    <a href="/products/new" class="btn btn-primary">List an item</a>
  </div>
  <form method="GET" action="/products" id="product-filters" class="row" style="margin-bottom:28px;">
    <input name="q" placeholder="Search gear…" value="<%= query.q || '' %>" style="background:var(--surface-2); border:1px solid var(--line); color:var(--text); padding:10px 12px; border-radius:3px; min-width:200px;" />
    <select name="category" style="background:var(--surface-2); border:1px solid var(--line); color:var(--text); padding:10px 12px; border-radius:3px;">
      <option value="">All categories</option>
      <% categories.forEach(function(c) { %>
        <option value="<%= c %>" <%= query.category === c ? 'selected' : '' %>><%= c %></option>
      <% }) %>
    </select>
    <select name="condition" style="background:var(--surface-2); border:1px solid var(--line); color:var(--text); padding:10px 12px; border-radius:3px;">
      <option value="">Any condition</option>
      <option value="new" <%= query.condition === 'new' ? 'selected' : '' %>>New</option>
      <option value="secondhand" <%= query.condition === 'secondhand' ? 'selected' : '' %>>Secondhand</option>
    </select>
    <select name="sort" style="background:var(--surface-2); border:1px solid var(--line); color:var(--text); padding:10px 12px; border-radius:3px;">
      <option value="newest" <%= sortKey === 'newest' ? 'selected' : '' %>>Newest first</option>
      <option value="price_asc" <%= sortKey === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
      <option value="price_desc" <%= sortKey === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
      <option value="rating" <%= sortKey === 'rating' ? 'selected' : '' %>>Top rated</option>
    </select>
    <button class="btn btn-secondary" type="submit">Filter</button>
    <% if (currentUser) { %>
      <button type="button" class="btn btn-secondary" id="save-search-btn">Save this search</button>
    <% } %>
  </form>

  <div id="recently-viewed" style="display:none; margin-bottom:36px;">
    <h2 class="section-title" style="font-size:16px;">Recently viewed</h2>
    <div class="grid" id="recently-viewed-grid"></div>
  </div>

  <% if (products.length === 0) { %>
    <div class="empty-state">
      <p>No listings match yet. <a href="/products/new">List the first piece of gear.</a></p>
    </div>
  <% } else { %>
    <div class="grid">
      <% products.forEach(function(p) { %>
        <a class="card" href="/products/<%= p._id %>" style="text-decoration:none; color:inherit;">
          <div class="card-media"><% if (p.images[0]) { %><img src="<%= p.images[0] %>" alt="<%= p.title %>"/><% } else { %>NO IMAGE<% } %></div>
          <div class="gear-tag">₫<%= p.pricing.listPrice.toLocaleString() %></div>
          <div class="card-body">
            <div class="card-title"><%= p.title %></div>
            <span class="condition-badge <%= p.condition === 'new' ? 'new' : '' %>"><%= p.condition %></span>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
<script src="/js/product.js"></script>
<%- include('../partials/footer') %>
