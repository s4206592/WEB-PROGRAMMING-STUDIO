<%- include('../partials/header', { pageTitle: (seller.profile.displayName || seller.username) + "'s listings" }) %>
<div class="container" style="padding:40px 0;">
  <div class="card" style="padding:20px; margin-bottom:32px;">
    <div class="row" style="align-items:center; gap:16px;">
      <% if (seller.profile.avatarUrl) { %>
        <img src="<%= seller.profile.avatarUrl %>" alt="" style="width:56px; height:56px; border-radius:50%; object-fit:cover;" />
      <% } %>
      <div>
        <h1 class="section-title" style="margin-bottom:2px;"><%= seller.profile.displayName || seller.username %></h1>
        <p class="muted mono" style="font-size:12px; margin:0;">@<%= seller.username %> · Member since <%= new Date(seller.createdAt).toLocaleDateString() %></p>
      </div>
    </div>
    <% if (seller.profile.bio) { %><p style="margin-top:14px;"><%= seller.profile.bio %></p><% } %>
    <p class="muted mono" style="font-size:12px; margin-top:14px; margin-bottom:0;">
      <% if (avgRating !== null) { %>
        Rating: <%= avgRating %> ★ (<%= reviewCount %> review<%= reviewCount === 1 ? '' : 's' %> across their listings)
      <% } else { %>
        No reviews yet
      <% } %>
    </p>
  </div>

  <h2 class="section-title" style="font-size:16px;">Active listings (<%= products.length %>)</h2>
  <% if (products.length === 0) { %>
    <div class="empty-state">No active listings from this seller right now.</div>
  <% } else { %>
    <div class="grid">
      <% products.forEach(function(p) { %>
        <a class="card" href="/products/<%= p._id %>" style="text-decoration:none; color:inherit;">
          <div class="card-media"><% if (p.images[0]) { %><img src="<%= p.images[0] %>" alt="<%= p.title %>"/><% } else { %>NO IMAGE<% } %></div>
          <div class="gear-tag">₫<%= p.pricing.listPrice.toLocaleString() %></div>
          <div class="card-body">
            <div class="card-title"><%= p.title %></div>
            <span class="condition-badge <%= p.condition === 'new' ? 'new' : '' %>"><%= p.condition %></span>
            <% if (p.pickup && p.pickup.available && p.pickup.city) { %>
              <span class="muted" style="display:block; font-size:12px; margin-top:4px;">📍 Pickup in <%= p.pickup.city %></span>
            <% } %>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
