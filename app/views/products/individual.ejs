<%- include('../partials/header', { pageTitle: product.title }) %>
<div class="container" style="padding:40px 0;">
  <div class="two-col">
    <div>
      <div class="card-media" style="border-radius:3px; aspect-ratio:1;">
        <% if (product.images[0]) { %><img src="<%= product.images[0] %>" alt="<%= product.title %>"/><% } else { %>NO IMAGE<% } %>
      </div>
    </div>
    <div>
      <span class="condition-badge <%= product.condition === 'new' ? 'new' : '' %>"><%= product.condition %></span>
      <h1 style="margin-top:10px;"><%= product.title %></h1>
      <p class="mono" style="font-size:22px; color:var(--neon);">₫<%= product.pricing.listPrice.toLocaleString() %><% if (product.pricing.negotiable && product.status === 'active') { %> <span class="muted mono" style="font-size:12px;">(negotiable)</span><% } %></p>
      <p class="muted">Sold by <strong><%= product.sellerSnapshot.username %></strong></p>
      <p><%= product.description %></p>

      <% if (product.status === 'sold') { %>
        <p class="pill pill-flagged" style="margin:24px 0; display:inline-block;">Sold out</p>
      <% } else if (product.status !== 'active') { %>
        <p class="pill pill-pending" style="margin:24px 0; display:inline-block;">Not currently available</p>
      <% } else { %>
        <div class="row" style="margin:24px 0;">
          <% if (currentUser) { %>
            <button class="btn btn-primary" data-add-to-cart="<%= product._id %>">Add to cart</button>
            <button class="btn btn-secondary" data-add-to-wishlist="<%= product._id %>">Save to wishlist</button>
          <% } else { %>
            <a href="/login?next=/products/<%= product._id %>" class="btn btn-primary">Log in to buy</a>
          <% } %>
        </div>
      <% } %>

      <% if (currentUser && String(currentUser.id) !== String(product.sellerId)) { %>
        <div class="row" style="margin-bottom:24px;">
          <form method="POST" action="/messages/start">
            <input type="hidden" name="toUserId" value="<%= product.sellerId %>" />
            <input type="hidden" name="productId" value="<%= product._id %>" />
            <button class="btn btn-secondary" type="submit">Message seller</button>
          </form>
          <% if (product.pricing.negotiable && product.status === 'active') { %>
            <form method="POST" action="/messages/start">
              <input type="hidden" name="toUserId" value="<%= product.sellerId %>" />
              <input type="hidden" name="productId" value="<%= product._id %>" />
              <button class="btn btn-secondary" type="submit">Negotiate price</button>
            </form>
          <% } %>
        </div>
      <% } %>

      <% if (canManage) { %>
        <div class="row" style="margin-bottom:24px;">
          <a href="/products/<%= product._id %>/edit" class="btn btn-secondary">Edit listing</a>
        </div>
      <% } %>

      <p class="muted mono" style="font-size:12px;">Rating: <%= product.ratingSummary.avg || '—' %> (<%= product.ratingSummary.count %> review<%= product.ratingSummary.count === 1 ? '' : 's' %>)</p>
    </div>
  </div>
  <div id="page-product" style="display:none;"
       data-id="<%= product._id %>" data-title="<%= product.title %>"
       data-price="<%= product.pricing.listPrice %>" data-image="<%= product.images[0] || '' %>"></div>

  <div style="margin-top:56px;">
    <div class="between" style="align-items:flex-end;">
      <h2 class="section-title" style="margin-bottom:24px;">Reviews</h2>
      <% if (reviews.length > 0) { %>
        <form method="GET" action="/products/<%= product._id %>" style="margin-bottom:24px;">
          <select name="reviewSort" onchange="this.form.submit()" style="background:var(--surface-2); border:1px solid var(--line); color:var(--text); padding:8px 10px; border-radius:3px; font-size:13px;">
            <option value="newest" <%= reviewSortKey === 'newest' ? 'selected' : '' %>>Newest first</option>
            <option value="highest" <%= reviewSortKey === 'highest' ? 'selected' : '' %>>Highest rated</option>
            <option value="lowest" <%= reviewSortKey === 'lowest' ? 'selected' : '' %>>Lowest rated</option>
          </select>
        </form>
      <% } %>
    </div>
    <% if (reviews.length === 0) { %>
      <div class="empty-state">No reviews yet.</div>
    <% } else { %>
      <div class="stack">
        <% reviews.forEach(function(r) { %>
          <div class="card"><div class="card-body">
            <div class="stars"><% for(let i=0;i<5;i++){ %><%= i < r.rating ? '★' : '☆' %><% } %></div>
            <strong><%= r.title || '' %></strong>
            <p><%= r.comment %></p>
            <p class="muted" style="font-size:12px;">— <%= r.reviewerSnapshot.username %></p>
          </div></div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
<script src="/js/product.js"></script>
<%- include('../partials/footer') %>
