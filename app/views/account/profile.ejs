<%- include('../partials/header', { pageTitle: 'Profile' }) %>
<div class="container" style="padding:48px 0; max-width:640px;">
  <h1 class="section-title">Your profile</h1>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <p class="muted">Username: <strong class="mono"><%= user.username %></strong> · Role: <span class="pill pill-active"><%= user.role %></span></p>
  <form method="POST" action="/profile" style="margin-top:24px;">
    <div class="field">
      <label>Display name</label>
      <input name="displayName" value="<%= user.profile.displayName || '' %>" />
    </div>
    <div class="field">
      <label>Bio</label>
      <textarea name="bio" rows="3"><%= user.profile.bio || '' %></textarea>
    </div>
    <div class="field">
      <label>Address</label>
      <input name="address" value="<%= user.contact.address || '' %>" />
    </div>
    <div class="field">
      <label>City</label>
      <input name="city" value="<%= user.contact.city || '' %>" />
    </div>
    <button class="btn btn-primary" type="submit">Save changes</button>
  </form>
</div>
<%- include('../partials/footer') %>
