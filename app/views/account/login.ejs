<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="narrow">
  <div class="box">
    <div class="box-title">Sign in</div>
    <% if (errors.length) { %><div class="wf-note"><% errors.forEach(function(e){ %><div><%= e %></div><% }) %></div><% } %>
    <form method="post" action="/login">
      <div class="form-row">
        <label for="identifier">Email or username</label>
        <input id="identifier" type="text" name="identifier" value="<%= form.identifier || '' %>" required autocomplete="username">
      </div>
      <div class="form-row">
        <label for="password">Password</label>
        <input id="password" type="password" name="password" required autocomplete="current-password">
      </div>
      <div class="form-actions">
        <button class="btn" type="submit">Sign in</button>
        <a class="muted" href="/register">Create an account</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
