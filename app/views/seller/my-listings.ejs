<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="page-wrap">
  <div class="section-bar" style="margin-top:0;">
    <h2>My listings <span class="wf-label">(<%= listings.length %>)</span></h2>
    <a class="btn small" href="/sell/new">List an item</a>
  </div>
  <% if (!listings.length) { %>
    <%- include('../partials/empty', { emptyTitle: 'You have not listed anything', emptyBody: 'Post a lamp, a lens or a whole kit. You can set a fixed price or let buyers make offers.', emptyCta: { href: '/sell/new', label: 'List an item' } }) %>
  <% } else { %>
    <table class="wf-table">
      <thead><tr><th>Item</th><th>Status</th><th class="num">Price</th><th class="num">Stock</th><th class="num">Views</th><th class="num">Offers</th><th>Actions</th></tr></thead>
      <tbody>
      <% listings.forEach(function(p){ %>
        <tr>
          <td><a href="/products/<%= p.slug %>"><%= p.title %></a>
            <div class="wf-label"><%= p.isSecondhand ? 'Secondhand' : 'New' %> · <%= CONDITION_LABELS[p.condition] %></div></td>
          <td><span class="pill <%= p.status === 'active' ? 'ok' : (p.status === 'sold' ? 'neutral' : 'warn') %>"><%= p.status.replace(/_/g,' ') %></span></td>
          <td class="num"><%= formatVND(p.price) %></td>
          <td class="num"><%= availableQty(p) %> / <%= p.quantity %></td>
          <td class="num"><%= p.stats.views %></td>
          <td class="num"><%= p.stats.offers %></td>
          <td>
            <a class="btn small secondary" href="/sell/<%= p._id %>/edit">Edit</a>
            <% if (p.status === 'active') { %>
              <form method="post" action="/sell/<%= p._id %>/status" style="display:inline;">
                <input type="hidden" name="status" value="paused"><button class="btn small secondary" type="submit">Pause</button>
              </form>
            <% } else if (p.status === 'paused') { %>
              <form method="post" action="/sell/<%= p._id %>/status" style="display:inline;">
                <input type="hidden" name="status" value="active"><button class="btn small secondary" type="submit">Resume</button>
              </form>
            <% } %>
            <% if (['active','paused','draft'].includes(p.status)) { %>
              <form method="post" action="/sell/<%= p._id %>/status" style="display:inline;">
                <input type="hidden" name="status" value="removed"><button class="btn small danger" type="submit">Take down</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<%- include('../partials/footer') %>
