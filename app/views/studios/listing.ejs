<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="page-wrap">
  <div class="two-col">
    <aside class="box">
      <div class="box-title">Filter studios</div>
      <form method="get" action="/studios">
        <div class="form-row"><label for="q">Search</label>
          <input id="q" type="search" name="q" value="<%= q %>"></div>
        <div class="form-row"><label for="province">Province</label>
          <select id="province" name="province">
            <option value="">Anywhere</option>
            <% provinces.forEach(function(p){ %>
              <option value="<%= p %>" <%= activeProvince === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select></div>
        <div class="form-row"><label for="maxPrice">Max rate (₫)</label>
          <input id="maxPrice" type="text" name="maxPrice" value="<%= maxPrice %>"></div>
        <div class="filter-group">
          <div class="wf-label">Amenities</div>
          <% AMENITIES.forEach(function(a){ %>
            <label><input type="checkbox" name="amenity" value="<%= a %>" <%= activeAmenities.includes(a) ? 'checked' : '' %>> <%= a.replace(/_/g,' ') %></label>
          <% }) %>
        </div>
        <label><input type="checkbox" name="verified" value="1" <%= verifiedOnly ? 'checked' : '' %>> Verified studios only</label>
        <div class="form-actions">
          <button class="btn small" type="submit">Apply</button>
          <a class="btn small secondary" href="/studios">Clear</a>
        </div>
      </form>
      <hr class="rule">
      <% if (currentUser) { %>
        <a class="btn small" href="/studios/new">List your studio</a>
        <a class="btn small secondary" href="/studios/dashboard" style="margin-top:6px;">Owner dashboard</a>
      <% } %>
    </aside>

    <main>
      <div class="section-bar" style="margin-top:0;"><h2>Studios <span class="wf-label">(<%= studios.length %>)</span></h2></div>
      <% if (!studios.length) { %>
        <%- include('../partials/empty', {
          emptyTitle: 'No studios listed yet',
          emptyBody: 'Studio owners advertise their space here — equipment on site, hourly and day rates, and a booking enquiry form. Nobody has listed one yet.',
          emptyCta: currentUser ? { href: '/studios/new', label: 'List your studio' } : { href: '/register', label: 'Create an account' }
        }) %>
      <% } else { %>
        <div class="card-grid cols-2">
          <% studios.forEach(function(s){ %>
            <div class="box">
              <div class="placeholder-img" style="height:140px;<% if (s.coverImageUrl) { %>background-image:url('<%= s.coverImageUrl %>');background-size:cover;background-position:center;<% } %>"><%= s.coverImageUrl ? '' : 'No image' %></div>
              <div class="box-title" style="margin-top:10px;">
                <a href="/studios/<%= s.slug %>"><%= s.name %></a>
                <% if (s.verification.status === 'verified') { %><span class="pill ok">Verified</span><% } %>
                <% if (s.isFeatured) { %><span class="pill neutral">Sponsored</span><% } %>
              </div>
              <div class="muted"><%= [s.address.district, s.address.province].filter(Boolean).join(', ') %></div>
              <% if (s.fromPrice) { %><div class="price">from <%= formatVND(s.fromPrice) %></div><% } %>
              <% if (s.capacity) { %><div class="wf-label">Up to <%= s.capacity %> people<%= s.areaSqm ? ' · ' + s.areaSqm + ' m²' : '' %></div><% } %>
              <p class="muted" style="font-size:12px;"><%= (s.description || '').slice(0, 120) %></p>
              <a class="btn small" href="/studios/<%= s.slug %>">View studio</a>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
