<%- include('../partials/header', { pageTitle: 'Admin' }) %>
<div class="container" style="padding:40px 0;">
  <h1 class="section-title">Admin dashboard</h1>
  <div class="grid" style="grid-template-columns: repeat(auto-fit,minmax(160px,1fr));">
    <div class="card"><div class="card-body"><p class="muted mono" style="font-size:11px;">USERS</p><h2><%= stats.users %></h2></div></div>
    <div class="card"><div class="card-body"><p class="muted mono" style="font-size:11px;">ACTIVE LISTINGS</p><h2><%= stats.listings %></h2></div></div>
    <div class="card"><div class="card-body"><p class="muted mono" style="font-size:11px;">ORDERS</p><h2><%= stats.orders %></h2></div></div>
    <div class="card"><div class="card-body"><p class="muted mono" style="font-size:11px;">OPEN FLAGS</p><h2><%= stats.openFlags %></h2></div></div>
  </div>
  <div class="row" style="margin-top:28px;">
    <a href="/admin/users" class="btn btn-secondary">Manage users</a>
    <a href="/admin/moderation" class="btn btn-secondary">Moderation queue</a>
    <a href="/blog/staff" class="btn btn-secondary">Blog review</a>
  </div>
</div>
<%- include('../partials/footer') %>
