  <header class="topbar">
    <a class="logo" href="/">STUDIOTRADE</a>
    <nav>
      <a href="/products" class="<%= path.startsWith('/products') ? 'current' : '' %>">Products</a>
      <a href="/forum" class="<%= path.startsWith('/forum') ? 'current' : '' %>">Forum</a>
      <a href="/blog" class="<%= path.startsWith('/blog') ? 'current' : '' %>">Blog</a>
      <a href="/studios" class="<%= path.startsWith('/studios') ? 'current' : '' %>">Studios</a>
      <a href="/faq" class="<%= path.startsWith('/faq') ? 'current' : '' %>">FAQ</a>
      <% if (currentUser) { %>
        <a href="/sell/new" class="<%= path.startsWith('/sell') ? 'current' : '' %>">Sell an item</a>
      <% } %>
    </nav>
    <form class="topsearch" action="/products" method="get">
      <input class="search-box" type="search" name="q" placeholder="Search listings" value="<%= query.q || '' %>">
    </form>
    <div class="user-icons">
      <a class="icon-box" href="/wishlist" title="Wishlist">♡<% if (wishlistCount) { %><span class="badge"><%= wishlistCount %></span><% } %></a>
      <a class="icon-box" href="/cart" title="Cart">🛒<% if (cartCount) { %><span class="badge"><%= cartCount %></span><% } %></a>
      <a class="icon-box" href="/notifications" title="Notifications">🔔<% if (notifCount) { %><span class="badge"><%= notifCount %></span><% } %></a>
      <% if (currentUser) { %>
        <a class="icon-box" href="/account/profile" title="<%= currentUser.username %>">👤</a>
      <% } else { %>
        <a class="btn small" href="/login">Sign in</a>
      <% } %>
    </div>
  </header>
  <% if (typeof breadcrumb !== 'undefined' && breadcrumb) { %>
    <div class="breadcrumb"><%= breadcrumb %></div>
  <% } %>
  <% if (flashSuccess && flashSuccess.length) { %>
    <div class="flash success"><% flashSuccess.forEach(function(m){ %><div><%= m %></div><% }) %></div>
  <% } %>
  <% if (flashError && flashError.length) { %>
    <div class="flash error"><% flashError.forEach(function(m){ %><div><%= m %></div><% }) %></div>
  <% } %>
