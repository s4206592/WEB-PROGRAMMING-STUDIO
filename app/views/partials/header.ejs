<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — StudioTrade' : 'StudioTrade' %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="brand">STUDIO<span>TRADE</span></a>
    <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-links" id="nav-links">
      <a href="/products">Marketplace</a>
      <a href="/forum">Forum</a>
      <a href="/forum/studios">Studios</a>
      <a href="/faq">FAQ</a>
      <a href="/blog">Blog</a>
      <% if (currentUser) { %>
        <a href="/wishlist">Wishlist</a>
        <a href="/cart">Cart <span class="badge-count" data-cart-count style="display:none"></span></a>
        <a href="/orders">Orders</a>
        <a href="/orders/selling">Selling</a>
        <a href="/messages">Messages</a>
        <a href="/profile"><%= currentUser.username %></a>
        <% if (currentUser.role === 'admin') { %><a href="/admin">Admin</a><% } %>
        <form action="/logout" method="POST" class="nav-logout-form"><button class="btn btn-secondary" type="submit" style="padding:8px 14px;">Log out</button></form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a href="/register" class="btn btn-primary" style="padding:8px 14px;">Sign up</a>
      <% } %>
    </div>
  </div>
</nav>
<main>
