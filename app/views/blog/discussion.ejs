<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="wide">
  <div class="box">
    <div class="box-title">Discussion — <a href="/blog/<%= post.slug %>"><%= post.title %></a></div>
    <div class="wf-label"><%= commentCount %> comment<%= commentCount === 1 ? '' : 's' %></div>
  </div>

  <% if (currentUser) { %>
    <div class="box" style="margin-top:16px;">
      <form method="post" action="/blog/<%= post.slug %>/comments">
        <div class="form-row">
          <label for="body">Add a comment</label>
          <textarea id="body" name="body" rows="3" maxlength="1500" required></textarea>
        </div>
        <button class="btn" type="submit">Post comment</button>
      </form>
    </div>
  <% } else { %>
    <div class="box" style="margin-top:16px;"><p class="muted"><a href="/login">Sign in</a> to join the discussion.</p></div>
  <% } %>

  <div class="box" style="margin-top:16px;">
    <% if (!top.length) { %>
      <p class="muted">Nobody has commented yet. Be the first.</p>
    <% } %>
    <% top.forEach(function(c){ %>
      <div class="review-item">
        <div class="review-head">
          <strong><%= c.authorId ? c.authorId.username : 'Anonymous' %></strong>
          <span class="wf-label"><%= timeAgo(c.createdAt) %></span>
        </div>
        <p><%= c.body %></p>
        <% if (currentUser) { %>
          <div style="display:flex;gap:8px;align-items:center;">
            <details>
              <summary class="wf-label" style="cursor:pointer;">Reply</summary>
              <form method="post" action="/blog/<%= post.slug %>/comments" style="margin-top:6px;">
                <input type="hidden" name="parentId" value="<%= c._id %>">
                <div class="form-row"><textarea name="body" rows="2" required></textarea></div>
                <button class="btn small" type="submit">Post reply</button>
              </form>
            </details>
            <form method="post" action="/blog/comments/<%= c._id %>/report">
              <input type="hidden" name="reason" value="offensive">
              <button class="linkbtn" type="submit">Report</button>
            </form>
            <% if (String(c.authorId && c.authorId._id) === String(currentUser._id) || currentUser.roles.includes('moderator') || currentUser.roles.includes('admin')) { %>
              <form method="post" action="/blog/comments/<%= c._id %>/delete">
                <button class="linkbtn" type="submit">Delete</button>
              </form>
            <% } %>
          </div>
        <% } %>

        <% (repliesByParent[c._id] || []).forEach(function(r){ %>
          <div style="margin-left:24px;margin-top:10px;padding-left:10px;border-left:2px solid #ddd;">
            <div class="review-head">
              <strong><%= r.authorId ? r.authorId.username : 'Anonymous' %></strong>
              <span class="wf-label"><%= timeAgo(r.createdAt) %></span>
            </div>
            <p><%= r.body %></p>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
</div>
<%- include('../partials/footer') %>
