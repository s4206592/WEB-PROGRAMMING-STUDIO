<%- include('../partials/header', { pageTitle: post.title }) %>
<div class="container" style="padding:40px 0; max-width:680px;">
  <span class="condition-badge"><%= post.category %></span>
  <h1><%= post.title %></h1>
  <p class="muted">by <%= post.authorSnapshot.username %></p>
  <% if (post.relatedProductId) { %>
    <a href="/products/<%= post.relatedProductId %>" class="card" style="display:flex; gap:10px; align-items:center; padding:12px 16px; margin:16px 0; text-decoration:none; color:inherit;">
      <% if (post.relatedProductSnapshot && post.relatedProductSnapshot.image) { %><img src="<%= post.relatedProductSnapshot.image %>" alt="" style="width:40px; height:40px; object-fit:cover; border-radius:3px;" /><% } %>
      <span style="font-size:13px;">About this listing: <strong><%= post.relatedProductSnapshot ? post.relatedProductSnapshot.title : 'View listing' %></strong></span>
    </a>
  <% } %>
  <p><%= post.body %></p>

  <h3 style="margin-top:36px;">Comments</h3>
  <% if (comments.length === 0) { %><p class="muted">No comments yet.</p><% } %>
  <div class="stack">
    <% comments.forEach(function(c) { %>
      <div class="card"><div class="card-body">
        <p><%= c.body %></p>
        <p class="muted" style="font-size:12px;">— <%= c.authorSnapshot.username %></p>
      </div></div>
    <% }) %>
  </div>

  <% if (currentUser) { %>
    <form id="comment-form" method="POST" action="/blog/<%= post._id %>/comment" style="margin-top:20px;">
      <div class="field"><textarea name="body" rows="3" placeholder="Add a comment…"></textarea><div class="field-error">Comment can't be empty.</div></div>
      <button class="btn btn-primary" type="submit">Comment</button>
    </form>
  <% } %>
</div>
<script src="/js/blog.js"></script>
<%- include('../partials/footer') %>
