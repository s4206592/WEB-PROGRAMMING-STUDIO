<%- include('../partials/header', { pageTitle: 'Forum' }) %>
<div class="container" style="padding:40px 0; max-width:760px;">
  <div class="between" style="margin-bottom:24px;">
    <h1 class="section-title" style="margin-bottom:0;">Forum</h1>
    <% if (currentUser) { %><a href="/forum/new" class="btn btn-primary">Ask a question</a><% } %>
  </div>
  <form method="GET" action="/forum" class="row" style="margin-bottom:24px;">
    <input name="q" placeholder="Search posts…" value="<%= query.q || '' %>" style="background:var(--surface-2); border:1px solid var(--line); color:var(--text); padding:10px 12px; border-radius:3px; min-width:200px;" />
    <select name="sort" style="background:var(--surface-2); border:1px solid var(--line); color:var(--text); padding:10px 12px; border-radius:3px;">
      <option value="newest" <%= sortKey === 'newest' ? 'selected' : '' %>>Newest</option>
      <option value="popular" <%= sortKey === 'popular' ? 'selected' : '' %>>Most upvoted</option>
    </select>
    <button class="btn btn-secondary" type="submit">Search</button>
  </form>
  <% if (posts.length === 0) { %>
    <div class="empty-state">No posts yet — start the conversation.</div>
  <% } else { %>
    <div class="stack">
      <% posts.forEach(function(p) { %>
        <a class="card" href="/forum/<%= p._id %>" style="text-decoration:none; color:inherit;"><div class="card-body">
          <strong><%= p.title %></strong>
          <p class="muted" style="font-size:13px;">by <%= p.authorSnapshot.username %></p>
        </div></a>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
