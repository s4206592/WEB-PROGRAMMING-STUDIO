<%- include('../partials/header', { pageTitle: 'New post' }) %>
<div class="container" style="padding:40px 0; max-width:560px;">
  <h1 class="section-title">Ask a question</h1>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form id="new-post-form" method="POST" action="/forum/new">
    <div class="field"><label>Title</label><input name="title" value="<%= old.title || '' %>" /><div class="field-error">Title must be at least 4 characters.</div></div>
    <div class="field"><label>Details</label><textarea name="body" rows="5"><%= old.body || '' %></textarea><div class="field-error">Add a bit more detail (10+ characters).</div></div>
    <div class="field"><label>Tags (comma-separated, optional)</label><input name="tags" /></div>
    <button class="btn btn-primary btn-block" type="submit">Post</button>
  </form>
</div>
<script src="/js/forum.js"></script>
<%- include('../partials/footer') %>
