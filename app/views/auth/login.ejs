<%- include('../partials/header', { pageTitle: 'Log in' }) %>
<div class="container" style="padding:56px 0; display:flex; justify-content:center;">
  <div class="form-card">
    <h2>Log in</h2>
    <% if (typeof resetSuccess !== 'undefined' && resetSuccess) { %><div class="alert alert-success">Password reset — log in with your new password.</div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form id="login-form" method="POST" action="/login" novalidate>
      <input type="hidden" name="next" value="<%= next %>" />
      <div class="field">
        <label for="identifier">Username or email</label>
        <input id="identifier" name="identifier" required />
        <div class="field-error"></div>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <div class="row">
          <input id="password" type="password" name="password" required style="flex:1;" />
          <button type="button" class="btn btn-secondary" data-toggle-password="password" style="padding:11px 14px;">Show</button>
        </div>
        <div class="field-error"></div>
      </div>
      <button class="btn btn-primary btn-block" type="submit">Log in</button>
    </form>
    <p class="muted" style="margin-top:14px;">
      <a href="/forgot-password">Forgot password?</a> · New here? <a href="/register">Create an account</a>
    </p>
  </div>
</div>
<script src="/js/auth.js"></script>
<%- include('../partials/footer') %>
