<%- include('../partials/header', { pageTitle: 'Forgot password' }) %>
<div class="container" style="padding:56px 0; display:flex; justify-content:center;">
  <div class="form-card">
    <h2>Forgot password</h2>
    <p class="muted" style="font-size:13px; margin-top:-6px;">Enter the email on your account and we'll get you a reset link.</p>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="/forgot-password" novalidate>
      <div class="field">
        <label for="email">Account email</label>
        <input id="email" type="email" name="email" required />
      </div>
      <button class="btn btn-primary btn-block" type="submit">Send reset link</button>
    </form>
    <p class="muted" style="margin-top:14px;"><a href="/login">Back to log in</a></p>
  </div>
</div>
<%- include('../partials/footer') %>
