<%- include('../partials/header', { pageTitle: 'Reset password' }) %>
<div class="container auth-wrap">
  <div class="form-card">
    <h2>Choose a new password</h2>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (token) { %>
      <form id="reset-password-form" method="POST" action="/reset-password/<%= token %>" novalidate>
        <div class="field">
          <label for="password">New password</label>
          <div class="row">
            <input id="password" type="password" name="password" required minlength="8" style="flex:1;" />
            <button type="button" class="btn btn-secondary" data-toggle-password="password" style="padding:11px 14px;">Show</button>
          </div>
          <div class="field-error"></div>
        </div>
        <div class="field">
          <label for="confirmPassword">Confirm new password</label>
          <div class="row">
            <input id="confirmPassword" type="password" name="confirmPassword" required minlength="8" style="flex:1;" />
            <button type="button" class="btn btn-secondary" data-toggle-password="confirmPassword" style="padding:11px 14px;">Show</button>
          </div>
          <div class="field-error"></div>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Reset password</button>
      </form>
    <% } else { %>
      <a href="/forgot-password" class="btn btn-primary btn-block">Request a new link</a>
    <% } %>
  </div>
</div>
<script src="/js/auth.js"></script>
<%- include('../partials/footer') %>
