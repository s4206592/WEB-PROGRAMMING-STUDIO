# ── MongoDB ────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/studiotrade
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/studiotrade?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/studiotrade

# ── Session ────────────────────────────────────────────────
# Any long random string. Render can generate this for you.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Seeded admin account (created automatically on first boot) ──
ADMIN_EMAIL=admin@studiotrade.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=+84900000000

# ── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
